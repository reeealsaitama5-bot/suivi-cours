# Copiez ce fichier en .streamlit/secrets.toml (local) ou collez son contenu
# dans Settings > Secrets sur Streamlit Community Cloud.
# NE JAMAIS committer secrets.toml sur GitHub.

# ID de la feuille : la partie entre /d/ et /edit dans l'URL du Google Sheet
sheet_id = "COLLEZ_ICI_L_ID_DE_VOTRE_FEUILLE"

# Contenu du fichier JSON de la clé du compte de service
[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "nom@projet.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
